<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <Style TargetType="Button" x:Key="successButton">
            <Setter Property="Background" Value="Green"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style TargetType="Button" x:Key="dangerButton">
            <Setter Property="Background" Value="Red"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style TargetType="Button" x:Key="normalButton">
            <Setter Property="Background" Value="SteelBlue"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style TargetType="TextBox" x:Key="normalTextBox">
            <Setter Property="Width" Value="250"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Background" Value="AliceBlue"/>
            <Setter Property="BorderBrush" Value="SteelBlue"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style TargetType="TextBox" x:Key="shortTextBox">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Background" Value="LightYellow"/>
            <Setter Property="BorderBrush" Value="Orange"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style TargetType="Label" x:Key="titleLabel">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="Foreground" Value="DarkBlue"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style TargetType="Label" x:Key="subTitleabel">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="DarkSlateGray"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="Label" x:Key="warningLabel">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="Background" Value="LightYellow"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Label Content="Name: " Grid.ColumnSpan="2" HorizontalAlignment="Center"/>
        <Label Content="E-mail: " Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Center"/>
        <Label Content="Phone Number: " Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Center"/>
        <Label Content="Postal Code: " Grid.Row="3" Grid.ColumnSpan="2" HorizontalAlignment="Center"/>
        <TextBox Text="Name: " Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource normalTextBox}"/>
        <TextBox Text="E-mail: " Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource normalTextBox}"/>
        <TextBox Text="Phone Number: " Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource normalTextBox}"/>
        <TextBox Text="Postal Code: " Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource shortTextBox}"/>
        <Button Content="Save" Grid.Column="4" Grid.ColumnSpan="2" Style="{StaticResource successButton}"/>
        <Button Content="Modify" Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2" Style="{StaticResource normalButton}"/>
        <Button Content="Delete" Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="2" Style="{StaticResource dangerButton}"/>
        <Button Content="Quit" Grid.Row="3" Grid.Column="4" Grid.ColumnSpan="2" Style="{StaticResource dangerButton}"/>
        <ComboBox Grid.Row="4" Grid.ColumnSpan="2">
            <ComboBoxItem Content="Python"/>
            <ComboBoxItem Content="C#"/>
            <ComboBoxItem Content="JavaScript"/>
        </ComboBox>
        <ComboBox Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2">
            <ComboBoxItem Content="MySQL"/>
            <ComboBoxItem Content="PostgreSQL"/>
            <ComboBoxItem Content="SQLite"/>
        </ComboBox>
        <ComboBox Grid.Row="4" Grid.Column="4" Grid.ColumnSpan="2">
            <ComboBoxItem Content="Math"/>
            <ComboBoxItem Content="IT"/>
            <ComboBoxItem Content="English"/>
        </ComboBox>
    </Grid>
</Window>
